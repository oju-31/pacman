{
  "name": "pacman-game",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "docker:build": "docker build -t pacman-game .",
    "docker:run": "docker run -p 3000:80 pacman-game",
    "docker:compose": "docker-compose up -d",
    "docker:compose:build": "docker-compose up --build -d",
    "docker:stop": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  }
}
